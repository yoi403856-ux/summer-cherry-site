# Copy this file to .env.local and fill in your Sanity project details.
# Until these are set, the site runs on built-in sample data.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-07-01

# Used to build absolute URLs for sitemap.xml, hreflang tags, and og:image.
# Set to the real domain once it's live (e.g. https://summer-cherry.com) —
# until then it falls back to the Vercel preview URL.
NEXT_PUBLIC_SITE_URL=

# Shared secret checked by app/api/revalidate/route.js. Set the same value
# in the Sanity webhook URL (?secret=...) — see the setup instructions at
# the bottom of that route's PR/commit, or ask whoever wired it up.
SANITY_REVALIDATE_SECRET=
